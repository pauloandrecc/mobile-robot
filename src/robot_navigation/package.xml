<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robot_navigation</name>
  <version>0.0.0</version>
  <description>Waypoint navigation on top of Nav2: action server, command-line client and runtime speed limit service.</description>
  <maintainer email="paulocarvalho@poli.ufrj.br">Paulo</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>robot_interfaces</exec_depend>
  <exec_depend>nav2_msgs</exec_depend>
  <exec_depend>action_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>ament_xmllint</test_depend>
  <test_depend>python3-pytest</test_depend>
  <!-- test_waypoint_action_server.py: launch_testing + fake Nav2. The
       message packages are also exec_depend; listed again because CI
       installs only build and test dependencies. -->
  <test_depend>launch</test_depend>
  <test_depend>launch_ros</test_depend>
  <test_depend>launch_testing</test_depend>
  <test_depend>launch_testing_ros</test_depend>
  <test_depend>rclpy</test_depend>
  <test_depend>robot_interfaces</test_depend>
  <test_depend>nav2_msgs</test_depend>
  <test_depend>action_msgs</test_depend>
  <test_depend>geometry_msgs</test_depend>
  <test_depend>rcl_interfaces</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
