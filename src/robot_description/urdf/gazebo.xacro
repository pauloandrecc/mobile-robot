<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ── Gazebo material colors ── -->
  <gazebo reference="base_link">
    <material>Gazebo/Blue</material>
  </gazebo>

  <gazebo reference="left_wheel">
    <material>Gazebo/DarkGray</material>
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
  </gazebo>

  <gazebo reference="right_wheel">
    <material>Gazebo/DarkGray</material>
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
  </gazebo>

  <gazebo reference="caster_wheel">
    <material>Gazebo/Gray</material>
    <mu1>0.01</mu1>
    <mu2>0.01</mu2>
  </gazebo>

  <!-- ── Differential drive plugin (Gazebo Jetty syntax) ── -->
  <gazebo>
    <plugin filename="gz-sim-diff-drive-system"
            name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.26</wheel_separation>
      <wheel_radius>0.05</wheel_radius>
      <topic>/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>
      <tf_topic>/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <odom_publish_frequency>20</odom_publish_frequency>

      <!-- Realistic covariance values for a differential drive robot -->
      <!-- Pose covariance: [x, y, z, roll, pitch, yaw] diagonal -->
      <covariance_x>0.001</covariance_x>
      <covariance_y>0.001</covariance_y>
      <covariance_yaw>0.001</covariance_yaw>

      <!-- Velocity covariance -->
      <covariance_vx>0.001</covariance_vx>
      <covariance_vy>0.001</covariance_vy>
      <covariance_vyaw>0.001</covariance_vyaw>

    </plugin>
  </gazebo>

  <!-- ── Joint state publisher (Gazebo Jetty syntax) ── -->
  <gazebo>
    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
      <joint_name>left_wheel_joint</joint_name>
      <joint_name>right_wheel_joint</joint_name>
    </plugin>
  </gazebo>

  <!-- ── Lidar sensor ── -->
  <gazebo reference="lidar_link">
    <sensor name="lidar" type="gpu_lidar">
      <topic>/scan</topic>
      <update_rate>10</update_rate>
      <gz_frame_id>lidar_link</gz_frame_id>
      <lidar>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <!-- 360 samples, 1 deg apart: max = pi - 2*pi/360, so the first
                 and last rays don't overlap at +/-180 deg -->
            <min_angle>-3.14159</min_angle>
            <max_angle>3.12414</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.12</min>
          <max>10.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </lidar>
      <always_on>true</always_on>
      <visualize>true</visualize>
    </sensor>
  </gazebo>

  <!-- ── IMU sensor (needs gz-sim-imu-system in the world) ── -->
  <gazebo reference="imu_link">
    <sensor name="imu" type="imu">
      <topic>/imu</topic>
      <update_rate>100</update_rate>
      <gz_frame_id>imu_link</gz_frame_id>
      <always_on>true</always_on>
      <visualize>false</visualize>
      <imu>
        <!-- Gaussian noise roughly matching a low-cost MEMS IMU -->
        <angular_velocity>
          <x><noise type="gaussian"><mean>0</mean><stddev>0.002</stddev></noise></x>
          <y><noise type="gaussian"><mean>0</mean><stddev>0.002</stddev></noise></y>
          <z><noise type="gaussian"><mean>0</mean><stddev>0.002</stddev></noise></z>
        </angular_velocity>
        <linear_acceleration>
          <x><noise type="gaussian"><mean>0</mean><stddev>0.02</stddev></noise></x>
          <y><noise type="gaussian"><mean>0</mean><stddev>0.02</stddev></noise></y>
          <z><noise type="gaussian"><mean>0</mean><stddev>0.02</stddev></noise></z>
        </linear_acceleration>
      </imu>
    </sensor>
  </gazebo>

  <!-- ── Camera sensor (rendered by gz-sim-sensors-system) ── -->
  <gazebo reference="camera_link">
    <material>Gazebo/Black</material>
    <sensor name="camera" type="camera">
      <topic>/camera/image_raw</topic>
      <update_rate>15</update_rate>
      <!-- Images are expressed in the optical frame (z forward) -->
      <gz_frame_id>camera_optical_link</gz_frame_id>
      <always_on>true</always_on>
      <visualize>true</visualize>
      <camera>
        <camera_info_topic>/camera/camera_info</camera_info_topic>
        <horizontal_fov>1.047</horizontal_fov>  <!-- 60 deg -->
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>20.0</far>
        </clip>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.007</stddev>
        </noise>
      </camera>
    </sensor>
  </gazebo>

</robot>